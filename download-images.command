curl -fsSL -A 'Mozilla/5.0' -o 'WhatsApp-Image-2025-11-29-at-9.47.33-AM-768x1024.jpeg' "$B/2025/12/WhatsApp-Image-2025-11-29-at-9.47.33-AM-768x1024.jpeg" && echo '✓ WhatsApp-Image-2025-11-29-at-9.47.33-AM-768x1024.jpeg'
