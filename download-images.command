#!/bin/bash
# Downloads all Lokpriya Hospital photos into ./assets (run from the lokpriya-redesign folder)
cd "$(dirname "$0")" && mkdir -p assets && cd assets
B=https://lokpriyahospital.in/wp-content/uploads
curl -fsSL -A 'Mozilla/5.0' -o '1.jpg' "$B/2025/12/1.jpg" && echo '✓ 1.jpg'
curl -fsSL -A 'Mozilla/5.0' -o '2.jpg' "$B/2025/12/2.jpg" && echo '✓ 2.jpg'
curl -fsSL -A 'Mozilla/5.0' -o '3.jpg' "$B/2025/12/3.jpg" && echo '✓ 3.jpg'
