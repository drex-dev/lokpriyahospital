curl -fsSL -A 'Mozilla/5.0' -o '6.jpg' "$B/2025/12/6.jpg" && echo '✓ 6.jpg'
curl -fsSL -A 'Mozilla/5.0' -o 'Untitled-1.png' "$B/2025/12/Untitled-1.png" && echo '✓ Untitled-1.png'
curl -fsSL -A 'Mozilla/5.0' -o 'WhatsApp-Image-2025-11-29-at-9.47.21-AM-768x1024.jpeg' "$B/2025/12/WhatsApp-Image-2025-11-29-at-9.47.21-AM-768x1024.jpeg" && echo '✓ WhatsApp-Image-2025-11-29-at-9.47.21-AM-768x1024.jpeg'
